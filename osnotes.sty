% \fieldstack[style]{prefix}{anchor point}{label1,label2,...}: a column of
% fields named prefix-1, prefix-2, ... hanging below the given point.
\newcommand{\fieldstack}[4][field]{%
  \foreach \lab [count=\i, remember=\i as \j (initially 0)] in {#4} {%
    \ifnum\i=1
      \node[#1, anchor=north] (#2-\i) at (#3) {\lab};
    \else
      \node[#1, anchor=north] (#2-\i) at (#2-\j.south) {\lab};
    \fi
  }%
}

% \timeaxis{length}{height}: time axis at y = 0 and a vertical baseline
\newcommand{\timeaxis}[2]{%
  \draw[-{Stealth[length=2mm]}] (0,0) -- (#1,0) node[below left, font=\scriptsize\itshape] {Time};
  \draw (0,0) -- (0,#2);
}

% Gantt charts for scheduling examples, after the slides' job colors.
% Use inside a tikzpicture whose x unit is one time unit.
\definecolor{jobA}{HTML}{F8A5A0}
\definecolor{jobB}{HTML}{FFE36E}
\definecolor{jobC}{HTML}{A8DC7A}

% \ganttrow{y}{row label}{start/end/job,...}; a slot too narrow for its
% letter is labeled above the bar instead
\newcommand{\ganttrow}[3]{%
  \node[anchor=east, font=\scriptsize] at ($(0,#1)+(-1.5mm,0)$) {#2};
  \foreach \s/\e/\j in {#3} {%
    \draw[fill=job\j] ($(\s,#1)+(0,-2.2mm)$) rectangle ($(\e,#1)+(0,2.2mm)$);
    \pgfmathtruncatemacro{\w}{\e-\s}%
    \ifnum\w>4
      \node[font=\scriptsize] at ($({(\s+\e)/2},#1)$) {\j};
    \else
      \node[font=\tiny, above] at ($({(\s+\e)/2},#1)+(0,2.2mm)$) {\j};
    \fi
  }%
}

% \ganttaxis{y}{t1,t2,...}: tick labels below a row
\newcommand{\ganttaxis}[2]{%
  \foreach \t in {#2} {%
    \draw ($(\t,#1)+(0,-2.2mm)$) -- ++(0,-0.8mm) node[below, font=\tiny, inner sep=1pt] {\t};
  }%
}

